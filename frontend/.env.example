# Leave this UNSET for local development — Vite's dev server proxies
# "/api" requests to http://localhost:5000 automatically (see vite.config.js).
#
# For production (Vercel/Netlify), set this to your deployed backend URL
# with "/api" at the end, e.g.:
# VITE_API_URL=https://your-backend.onrender.com/api
VITE_API_URL=
